{
  "name": "@hyphae/admin-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "BUSL-1.1",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./openapi.json": "./dist/openapi.json"
  },
  "files": [
    "dist/index.js",
    "dist/index.d.ts",
    "dist/openapi.json",
    "LICENSE",
