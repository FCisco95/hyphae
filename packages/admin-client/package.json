    "test": "pnpm build && vitest run",
    "typecheck": "pnpm build && tsc --noEmit"
  },
  "dependencies": {
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "22.20.3",
    "esbuild": "0.27.7",
    "hono": "4.13.8",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
