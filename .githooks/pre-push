#!/bin/sh
# The local gate, run by git on every push (AGENTS.md: the hook is the gate; CI repeats it).
# Docs-only pushes skip it. Postgres suites run in CI only, since they need Docker.
set -e

zero=0000000000000000000000000000000000000000
changed=""
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue
  if [ "$remote_sha" = "$zero" ]; then
    base=$(git merge-base "$local_sha" origin/main 2>/dev/null || true)
  else
    base=$remote_sha
  fi
  if [ -z "$base" ]; then
    changed="$changed
(unknown base)"
  else
    changed="$changed
$(git diff --name-only "$base" "$local_sha")"
  fi
done

code=$(printf '%s\n' "$changed" | grep -v '^$' | grep -vE '^docs/|\.md$' || true)
if [ -z "$code" ]; then
  echo "pre-push: docs only, gate skipped"
  exit 0
fi

echo "pre-push: running the gate (pnpm test, typecheck, lint)"
pnpm test
pnpm typecheck
pnpm lint
if printf '%s\n' "$code" | grep -q '^packages/db/'; then
  pnpm --filter @hyphae/db exec drizzle-kit check
fi
