{
  "name": "@hyphae/api",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "build": "tsup && pnpm build:page",
    "build:page": "tsup --config tsup.page.config.ts && node -e \"for (const f of ['index.html', 'style.css']) require('node:fs').copyFileSync('src/link/page/' + f, 'dist/public/' + f)\"",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/link/page",
    "test": "vitest run --passWithNoTests",
    "eval:scoring": "node --import tsx scripts/eval-scoring.ts",
    "test:pg": "bash scripts/test-pg.sh"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.0",
    "@ai-sdk/deepseek": "^3.0.0",
    "@hono/node-server": "^1.14.0",
    "@hyphae/core": "workspace:*",
    "@hyphae/db": "workspace:*",
    "@noble/hashes": "^2.4.0",
    "@organichub/verify": "0.1.0",
    "@solana/kit": "^8.3.0",
    "ai": "^7.0.0",
    "drizzle-orm": "^0.45.0",
    "grammy": "^1.46.0",
    "hono": "^4.13.0",
    "pg-boss": "^12.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@ledgerhq/hw-app-solana": "7.11.0",
    "@ledgerhq/hw-transport-node-hid-noevents": "6.36.0",
    "@types/node": "^22.0.0",
    "@wallet-standard/app": "1.1.1",
    "tsup": "^8.0.0",
    "tsx": "^4.0.0",
    "vitest": "^3.0.0",
    "@hyphae/read-client": "workspace:*"
  }
}
