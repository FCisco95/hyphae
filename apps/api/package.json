{
  "name": "@hyphae/api",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "build": "tsup",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.0",
    "@ai-sdk/deepseek": "^3.0.0",
    "@hono/node-server": "^1.14.0",
    "@hyphae/core": "workspace:*",
    "@hyphae/db": "workspace:*",
    "@solana/kit": "^8.3.0",
    "ai": "^7.0.0",
    "drizzle-orm": "^0.45.0",
    "grammy": "^1.46.0",
    "hono": "^4.13.0",
    "pg-boss": "^12.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.0.0",
    "tsx": "^4.0.0",
    "vitest": "^3.0.0"
  }
}
