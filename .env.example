# Copy to .env (gitignored). Every variable the code reads is named here; no value below is real.

# apps/api: the api and worker processes (Fly secrets in production)
DATABASE_URL=postgres://user:pass@host/db?sslmode=require
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
SCORING_MODEL=anthropic:claude-sonnet-5
JEV_SCORING=off
TYPESAFE_API_KEY=
PUBLIC_WEB_URL=https://hyphae.fun
PORT=8080
LINK_ORIGIN=https://hyphae-api.fly.dev
LINK_CHAIN=solana:mainnet
# Hold gate (P16): two independent mainnet providers, the API key in each URL; the second must not
# be Helius. Each must answer with mainnet's genesis hash. Unset or refused, every candidate is held.
HOLD_RPC_HELIUS_URL=
HOLD_RPC_FALLBACK_URL=
# P14's read-only chain reads (epoch accounts, claim receipts), on the network the epochs are
# published to. Unset, the settlement sections say chain_unconfigured.
READ_RPC_URL=
# At least 32 random characters, the same value as HYPHAE_API_TOKEN on the web. With it the api
# limits the web's reads per visitor, instead of one window for every visitor.
READ_API_WEB_TOKEN=

# apps/web: the Next.js site (Vercel environment variables)
HYPHAE_API_URL=https://hyphae-api.fly.dev
# Local raid preview reader only; unset in production to use the regular API above.
# HYPHAE_RAID_API_URL=http://127.0.0.1:3011
# The mint of the community that / and /claim open.
DEFAULT_MINT=
# Server-side only, never sent to a browser; the same value as READ_API_WEB_TOKEN on the api.
HYPHAE_API_TOKEN=

# The offline scoring eval only (apps/api/scripts/eval-scoring.ts --backend jev); never a Fly secret.
TYPESAFE_API_KEY=

# One-off scripts and tests: set on the command line for that run, not here.
# apps/api/scripts/community-setup.ts: explicit private operator connection, no DATABASE_URL fallback.
# COMMUNITY_SETUP_DATABASE_URL=
# apps/api/scripts/seed-community.ts
# SEED_MINT=
# SEED_CHAT_ID=
# SEED_ADMIN_ID=
# Set by apps/api/scripts/test-pg.sh to its disposable Docker Postgres.
# HYPHAE_TEST_PG_URL=
# =1 rewrites packages/core/src/test-vectors/h-contract-v1.json from the code.
# UPDATE_VECTORS=
# The devnet harness, apps/api/src/payout/publish.devnet.test.ts: throwaway keys only, never mainnet.
# HYPHAE_DEVNET_RUN=
# HYPHAE_DEVNET_RPC=
# HYPHAE_DEVNET_WS=
# HYPHAE_DEVNET_ADMIN_KEYPAIR=
# HYPHAE_DEVNET_ADMIN_LEDGER=
# HYPHAE_DEVNET_CLAIMANT_KEYPAIR=
# HYPHAE_DEVNET_FEE_RECIPIENT=
# HYPHAE_DEVNET_MINT=
# HYPHAE_DEVNET_DATABASE_URL=
# HYPHAE_DEVNET_REPORT=
# Optional private member reads. All three must be valid or the surface stays unavailable.
# Dedicated Hyphae app only; server secret/key never go in NEXT_PUBLIC_* variables.
# No login activation until Privy production HttpOnly domain setup and attended smoke pass.
PRIVY_APP_ID=
PRIVY_APP_SECRET=
PRIVY_VERIFICATION_KEY=
# Web-only activation, after domain verification and attended cookie/login smoke.
# Keep off locally and on previews; both account page and proxy check the exact host.
# Vercel automatically sets VERCEL=1; only there is its overwritten x-real-ip trusted.
# VERCEL=
# Existing HYPHAE_API_TOKEN/READ_API_WEB_TOKEN attest visitor rate limits only, never membership.
PRIVY_LOGIN_ENABLED=off
PRIVY_LOGIN_HOST=
